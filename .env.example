# Docker Compose configuration. Copy to .env in the repository root.
# Defaults work for a browser on the same computer.
EXPO_HOST=localhost
EXPO_PUBLIC_API_URL=http://localhost:8080
WEB_ORIGIN=http://localhost:8081

# Development only: bypass Ready/countdown position checks, not real GPS updates.
TEST_SKIP_START_POSITION_CHECK=false

# Native Android Google Maps builds: application-restricted key.
# iOS uses Apple Maps and needs no key.
GOOGLE_MAPS_ANDROID_API_KEY=

# Physical phone: replace localhost with your computer's LAN IPv4 address.
# EXPO_HOST=192.168.1.100
# EXPO_PUBLIC_API_URL=http://192.168.1.100:8080
# WEB_ORIGIN=http://192.168.1.100:8081
