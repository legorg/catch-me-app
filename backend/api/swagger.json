                "playerId": {
                    "type": "string",
                    "maxLength": 32,
                    "minLength": 32,
                    "example": "8899aabbccddeeff0011223344556677"
                },
                "position": {
                    "description": "Live position: own always; hunter teammates' always; runner teammates'\nwhile running. Hunters see runners through reveals instead.",
                    "allOf": [
                        {
                            "$ref": "#/definitions/controller.PositionResponse"
                        }
                    ]
                },
                "ready": {
                    "type": "boolean",
                    "example": false
                },
                "reveals": {
                    "description": "Hunters only, for runners while running: every reveal so far, oldest first.",
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/controller.RevealResponse"
                    }
                },
                "team": {
                    "type": "string",
                    "enum": [
                        "runner",
                        "hunter"
                    ],
                    "example": "runner"
                }
            }
        },
        "controller.Playground": {
