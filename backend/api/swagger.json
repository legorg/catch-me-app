{
    "swagger": "2.0",
    "info": {
        "description": "API generated from Go handler annotations and response structs.",
        "title": "Catch me! API",
        "contact": {},
        "version": "0.1.0"
    },
    "basePath": "/",
    "paths": {
        "/api/games": {
            "post": {
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "summary": "Create a 6 by 6 playground with adjustable cell size (default 2000 meters)",
                "operationId": "createGame",
                "parameters": [
                    {
                        "description": "Both coordinates required; cellSizeMeters is 100-5000 in steps of 100, omitted/null defaults to 2000; no date-line crossings",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/controller.CreateGameRequest"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Game saved, with one join code per team",
                        "schema": {
                            "$ref": "#/definitions/controller.CreateGameResponse"
                        }
                    },
                    "400": {
                        "description": "Invalid JSON, coordinates, or cell size",
                        "schema": {
                            "$ref": "#/definitions/controller.APIError"
                        }
                    },
                    "405": {
                        "description": "Method not allowed",
                        "schema": {
                            "$ref": "#/definitions/controller.APIError"
                        }
                    },
                    "413": {
                        "description": "Request body exceeds 1024 bytes",
                        "schema": {
                            "$ref": "#/definitions/controller.APIError"
                        }
                    },
                    "422": {
                        "description": "No landmark found at the edges of the playground",
                        "schema": {
                            "$ref": "#/definitions/controller.APIError"
                        }
                    },
                    "500": {
                        "description": "Could not save game",
                        "schema": {
                            "$ref": "#/definitions/controller.APIError"
                        }
                    },
                    "503": {
                        "description": "Landmark lookup failed",
                        "schema": {
                            "$ref": "#/definitions/controller.APIError"
                        }
                    }
                }
            }
        },
        "/api/me": {
            "delete": {
                "security": [
                    {
                        "PlayerToken": []
                    }
                ],
                "produces": [
                    "application/json"
                ],
                "summary": "Leave the game before it starts",
                "operationId": "leaveGame",
                "responses": {
                    "204": {
                        "description": "Left the game; the token is no longer valid"
                    },
                    "401": {
                        "description": "Missing or unknown player token",
                        "schema": {
                            "$ref": "#/definitions/controller.APIError"
                        }
                    },
                    "405": {
                        "description": "Method not allowed",
                        "schema": {
                            "$ref": "#/definitions/controller.APIError"
                        }
                    },
                    "409": {
                        "description": "Game has already started",
                        "schema": {
                            "$ref": "#/definitions/controller.APIError"
                        }
                    },
                    "500": {
                        "description": "Could not update game",
                        "schema": {
                            "$ref": "#/definitions/controller.APIError"
                        }
                    }
                }
            }
        },
        "/api/me/game": {
            "get": {
                "security": [
                    {
                        "PlayerToken": []
                    }
                ],
                "produces": [
                    "application/json"
                ],
                "summary": "Get the game state for the authenticated player",
                "operationId": "getGameState",
                "responses": {
                    "200": {
                        "description": "Current game state",
                        "schema": {
                            "$ref": "#/definitions/controller.GameStateResponse"
                        }
                    },
                    "401": {
                        "description": "Missing or unknown player token",
                        "schema": {
                            "$ref": "#/definitions/controller.APIError"
                        }
                    },
                    "405": {
                        "description": "Method not allowed",
                        "schema": {
                            "$ref": "#/definitions/controller.APIError"
                        }
                    },
                    "500": {
                        "description": "Could not load game",
                        "schema": {
                            "$ref": "#/definitions/controller.APIError"
                        }
                    }
                }
            }
        },
        "/api/me/hunter-team": {
            "put": {
                "security": [
                    {
                        "PlayerToken": []
                    }
                ],
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "summary": "Join or create a hunter team",
                "operationId": "setHunterTeam",
                "parameters": [
                    {
                        "description": "Team name (1-20 characters); an existing team with this name (ignoring case) is joined, otherwise a new team is created",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/controller.SetHunterTeamRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Updated game state",
                        "schema": {
                            "$ref": "#/definitions/controller.GameStateResponse"
                        }
                    },
                    "400": {
                        "description": "Invalid JSON or team name",
                        "schema": {
                            "$ref": "#/definitions/controller.APIError"
                        }
                    },
                    "401": {
                        "description": "Missing or unknown player token",
                        "schema": {
                            "$ref": "#/definitions/controller.APIError"
                        }
                    },
                    "405": {
                        "description": "Method not allowed",
                        "schema": {
                            "$ref": "#/definitions/controller.APIError"
                        }
                    },
                    "409": {
                        "description": "Not a hunter, ready, or game started",
                        "schema": {
                            "$ref": "#/definitions/controller.APIError"
                        }
                    },
                    "413": {
                        "description": "Request body exceeds 1024 bytes",
                        "schema": {
                            "$ref": "#/definitions/controller.APIError"
                        }
                    },
                    "500": {
                        "description": "Could not update game",
                        "schema": {
                            "$ref": "#/definitions/controller.APIError"
                        }
                    }
                }
            }
        },
        "/api/me/jokers": {
            "post": {
                "security": [
                    {
                        "PlayerToken": []
                    }
                ],
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "summary": "Use a joker",
                "operationId": "activateJoker",
                "parameters": [
                    {
                        "description": "The joker to use; each hunter team can use each joker once, while the game runs",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/controller.UseJokerRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Updated game state, with what the joker showed",
                        "schema": {
                            "$ref": "#/definitions/controller.GameStateResponse"
                        }
                    },
                    "400": {
                        "description": "Invalid JSON or unknown joker",
                        "schema": {
                            "$ref": "#/definitions/controller.APIError"
                        }
                    },
                    "401": {
                        "description": "Missing or unknown player token",
                        "schema": {
                            "$ref": "#/definitions/controller.APIError"
                        }
                    },
                    "405": {
                        "description": "Method not allowed",
                        "schema": {
                            "$ref": "#/definitions/controller.APIError"
                        }
                    },
                    "409": {
                        "description": "Not a hunter in a team, game not running, or joker already used",
                        "schema": {
                            "$ref": "#/definitions/controller.APIError"
                        }
                    },
                    "413": {
                        "description": "Request body exceeds 1024 bytes",
                        "schema": {
                            "$ref": "#/definitions/controller.APIError"
                        }
                    },
                    "500": {
                        "description": "Could not update game",
                        "schema": {
                            "$ref": "#/definitions/controller.APIError"
                        }
                    }
                }
            }
        },
        "/api/me/position": {
            "put": {
                "security": [
                    {
                        "PlayerToken": []
                    }
                ],
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "summary": "Report the authenticated player's current position",
                "operationId": "updatePosition",
                "parameters": [
                    {
                        "description": "Current coordinates and accuracy radius; the server records its own time",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/controller.UpdatePositionRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Updated game state",
                        "schema": {
                            "$ref": "#/definitions/controller.GameStateResponse"
                        }
                    },
                    "400": {
                        "description": "Invalid JSON, coordinates, or accuracy",
                        "schema": {
                            "$ref": "#/definitions/controller.APIError"
                        }
                    },
                    "401": {
                        "description": "Missing or unknown player token",
                        "schema": {
                            "$ref": "#/definitions/controller.APIError"
                        }
                    },
                    "405": {
                        "description": "Method not allowed",
                        "schema": {
                            "$ref": "#/definitions/controller.APIError"
                        }
                    },
                    "413": {
                        "description": "Request body exceeds 1024 bytes",
                        "schema": {
                            "$ref": "#/definitions/controller.APIError"
                        }
                    },
                    "500": {
                        "description": "Could not update game",
                        "schema": {
                            "$ref": "#/definitions/controller.APIError"
                        }
                    }
                }
            }
        },
        "/api/me/ready": {
            "put": {
                "security": [
                    {
                        "PlayerToken": []
                    }
                ],
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "summary": "Set the authenticated player's ready state",
                "operationId": "setReady",
                "parameters": [
                    {
                        "description": "Ready state; the game starts 10 seconds after all players are ready and both teams have players",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/controller.SetReadyRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Updated game state",
                        "schema": {
                            "$ref": "#/definitions/controller.GameStateResponse"
                        }
                    },
                    "400": {
                        "description": "Invalid JSON or missing ready value",
                        "schema": {
                            "$ref": "#/definitions/controller.APIError"
                        }
                    },
                    "401": {
                        "description": "Missing or unknown player token",
                        "schema": {
                            "$ref": "#/definitions/controller.APIError"
                        }
                    },
                    "405": {
                        "description": "Method not allowed",
                        "schema": {
                            "$ref": "#/definitions/controller.APIError"
                        }
                    },
                    "409": {
                        "description": "Game has already started, or the runner is not in their start cell",
                        "schema": {
                            "$ref": "#/definitions/controller.APIError"
                        }
                    },
                    "413": {
                        "description": "Request body exceeds 1024 bytes",
                        "schema": {
                            "$ref": "#/definitions/controller.APIError"
                        }
                    },
                    "500": {
                        "description": "Could not update game",
                        "schema": {
                            "$ref": "#/definitions/controller.APIError"
                        }
                    }
                }
            }
        },
        "/api/me/route": {
            "post": {
                "security": [
                    {
                        "PlayerToken": []
                    }
                ],
                "produces": [
                    "application/json"
                ],
                "summary": "Regenerate the authenticated runner's route",
                "operationId": "regenerateRoute",
                "responses": {
                    "200": {
                        "description": "Updated game state with the new route",
                        "schema": {
                            "$ref": "#/definitions/controller.GameStateResponse"
                        }
                    },
                    "401": {
                        "description": "Missing or unknown player token",
                        "schema": {
                            "$ref": "#/definitions/controller.APIError"
                        }
                    },
                    "405": {
                        "description": "Method not allowed",
                        "schema": {
                            "$ref": "#/definitions/controller.APIError"
                        }
                    },
                    "409": {
                        "description": "Not a runner, ready, no changes left, or game started",
                        "schema": {
                            "$ref": "#/definitions/controller.APIError"
                        }
                    },
                    "500": {
                        "description": "Could not update game",
                        "schema": {
                            "$ref": "#/definitions/controller.APIError"
                        }
                    }
                }
            }
        },
        "/api/players": {
            "post": {
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "summary": "Join a game with a team join code",
                "operationId": "joinGame",
                "parameters": [
                    {
                        "description": "Join code (6 digits) and display name (1-20 characters, unique per game)",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/controller.JoinGameRequest"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Joined; keep the player token secret",
                        "schema": {
                            "$ref": "#/definitions/controller.JoinGameResponse"
                        }
                    },
                    "400": {
                        "description": "Invalid JSON, join code, or name",
                        "schema": {
                            "$ref": "#/definitions/controller.APIError"
                        }
                    },
                    "404": {
                        "description": "No game with this join code",
                        "schema": {
                            "$ref": "#/definitions/controller.APIError"
                        }
                    },
                    "405": {
                        "description": "Method not allowed",
                        "schema": {
                            "$ref": "#/definitions/controller.APIError"
                        }
                    },
                    "409": {
                        "description": "Game started, full, or name taken",
                        "schema": {
                            "$ref": "#/definitions/controller.APIError"
                        }
                    },
                    "413": {
                        "description": "Request body exceeds 1024 bytes",
                        "schema": {
                            "$ref": "#/definitions/controller.APIError"
                        }
                    },
                    "500": {
                        "description": "Could not join game",
                        "schema": {
                            "$ref": "#/definitions/controller.APIError"
                        }
                    }
                }
            }
        },
        "/health": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "summary": "Check backend health",
                "operationId": "getHealth",
                "responses": {
                    "200": {
                        "description": "Backend is running",
                        "schema": {
                            "$ref": "#/definitions/controller.HealthResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "controller.APIError": {
            "type": "object",
            "required": [
                "error"
            ],
            "properties": {
                "error": {
                    "type": "string",
                    "example": "cell size must be 100 to 5000 meters in steps of 100 meters"
                }
            }
        },
        "controller.Bounds": {
            "type": "object",
            "required": [
                "east",
                "north",
                "south",
                "west"
            ],
            "properties": {
                "east": {
                    "type": "number",
                    "maximum": 180,
                    "minimum": -180,
                    "example": 13.493678060701022
                },
                "north": {
                    "type": "number",
                    "maximum": 90,
                    "minimum": -90,
                    "example": 52.57395922182347
                },
                "south": {
                    "type": "number",
                    "maximum": 90,
                    "minimum": -90,
                    "example": 52.466040778176534
                },
                "west": {
                    "type": "number",
                    "maximum": 180,
                    "minimum": -180,
                    "example": 13.316321939298977
                }
            }
        },
        "controller.Coordinates": {
            "type": "object",
            "required": [
                "latitude",
                "longitude"
            ],
            "properties": {
                "latitude": {
                    "type": "number",
                    "maximum": 80,
                    "minimum": -80,
                    "example": 52.52
                },
                "longitude": {
                    "type": "number",
                    "maximum": 180,
                    "minimum": -180,
                    "example": 13.405
                }
            }
        },
        "controller.CreateGameRequest": {
            "type": "object",
            "required": [
                "latitude",
                "longitude"
            ],
            "properties": {
                "cellSizeMeters": {
                    "type": "integer",
                    "default": 2000,
                    "maximum": 5000,
                    "minimum": 100,
                    "example": 2000
                },
                "latitude": {
                    "type": "number",
                    "maximum": 80,
                    "minimum": -80,
                    "example": 52.52
                },
                "longitude": {
                    "type": "number",
                    "maximum": 180,
                    "minimum": -180,
                    "example": 13.405
                }
            }
        },
        "controller.CreateGameResponse": {
            "type": "object",
            "required": [
                "game",
                "joinCodes"
            ],
            "properties": {
                "game": {
                    "$ref": "#/definitions/controller.GameResponse"
                },
                "joinCodes": {
                    "$ref": "#/definitions/controller.JoinCodes"
                }
            }
        },
        "controller.GameResponse": {
            "type": "object",
            "required": [
                "createdAt",
                "playground",
                "route",
                "sessionId"
            ],
            "properties": {
                "createdAt": {
                    "type": "string",
                    "example": "2026-11-08T12:00:00Z"
                },
                "playground": {
                    "$ref": "#/definitions/controller.Playground"
                },
                "route": {
                    "$ref": "#/definitions/controller.GameRoute"
                },
                "sessionId": {
                    "type": "string",
                    "maxLength": 32,
                    "minLength": 32,
                    "example": "00112233445566778899aabbccddeeff"
                }
            }
        },
        "controller.GameRoute": {
            "type": "object",
            "required": [
                "distanceMeters",
                "start",
                "stop"
            ],
            "properties": {
                "distanceMeters": {
                    "description": "Straight-line (great-circle) distance between start and stop.",
                    "type": "number",
                    "minimum": 0,
                    "example": 10432.7
                },
                "start": {
                    "$ref": "#/definitions/controller.Landmark"
                },
                "stop": {
                    "$ref": "#/definitions/controller.Landmark"
                }
            }
        },
        "controller.GameStateResponse": {
            "type": "object",
            "required": [
                "joinCodes",
                "jokers",
                "playerId",
                "players",
                "playground",
                "serverTime",
                "sessionId",
                "status",
                "team"
            ],
            "properties": {
                "joinCodes": {
                    "$ref": "#/definitions/controller.JoinCodes"
                },
                "jokers": {
                    "description": "The requesting player's team's jokers; empty for runners (they have none yet) and hunters without a team.",
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/controller.JokerResponse"
                    }
                },
                "nextRevealAt": {
                    "description": "Next time hunters receive the runners' positions, present while running.",
                    "type": "string",
                    "example": "2026-11-08T12:05:10Z"
                },
                "playerId": {
                    "type": "string",
                    "maxLength": 32,
                    "minLength": 32,
                    "example": "8899aabbccddeeff0011223344556677"
                },
                "players": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/controller.PlayerResponse"
                    }
                },
                "playground": {
                    "$ref": "#/definitions/controller.Playground"
                },
                "route": {
                    "description": "The game's route between two landmarks; only runners get it, hunters have to find them.",
                    "allOf": [
                        {
                            "$ref": "#/definitions/controller.GameRoute"
                        }
                    ]
                },
                "serverTime": {
                    "type": "string",
                    "example": "2026-11-08T12:00:00Z"
                },
                "sessionId": {
                    "type": "string",
                    "maxLength": 32,
                    "minLength": 32,
                    "example": "00112233445566778899aabbccddeeff"
                },
                "startPositionCheckDisabled": {
                    "description": "Explicit server-side development override; absent during normal play.",
                    "type": "boolean",
                    "example": false
                },
                "startsAt": {
                    "description": "Scheduled start, present during the countdown and once running.",
                    "type": "string",
                    "example": "2026-11-08T12:00:10Z"
                },
                "status": {
                    "type": "string",
                    "enum": [
                        "lobby",
                        "countdown",
                        "running"
                    ],
                    "example": "lobby"
                },
                "team": {
                    "type": "string",
                    "enum": [
                        "runner",
                        "hunter"
                    ],
                    "example": "runner"
                }
            }
        },
        "controller.HealthResponse": {
            "type": "object",
            "required": [
                "service",
                "status"
            ],
            "properties": {
                "service": {
                    "type": "string",
                    "enum": [
                        "catch-me-backend"
                    ],
                    "example": "catch-me-backend"
                },
                "status": {
                    "type": "string",
                    "enum": [
                        "ok"
                    ],
                    "example": "ok"
                }
            }
        },
        "controller.JoinCodes": {
            "type": "object",
            "required": [
                "hunter",
                "runner"
            ],
            "properties": {
                "hunter": {
                    "type": "string",
                    "maxLength": 6,
                    "minLength": 6,
                    "example": "071564"
                },
                "runner": {
                    "type": "string",
                    "maxLength": 6,
                    "minLength": 6,
                    "example": "482913"
                }
            }
        },
        "controller.JoinGameRequest": {
            "type": "object",
            "required": [
                "code",
                "name"
            ],
            "properties": {
                "code": {
                    "type": "string",
                    "maxLength": 6,
                    "minLength": 6,
                    "example": "482913"
                },
                "name": {
                    "type": "string",
                    "maxLength": 20,
                    "minLength": 1,
                    "example": "Ada"
                }
            }
        },
        "controller.JoinGameResponse": {
            "type": "object",
            "required": [
                "playerToken",
                "state"
            ],
            "properties": {
                "playerToken": {
                    "type": "string",
                    "maxLength": 64,
                    "minLength": 64,
                    "example": "00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff"
                },
                "state": {
                    "$ref": "#/definitions/controller.GameStateResponse"
                }
            }
        },
        "controller.JokerPositionResponse": {
            "type": "object",
            "required": [
                "accuracyMeters",
                "latitude",
                "longitude",
                "playerId",
                "recordedAt"
            ],
            "properties": {
                "accuracyMeters": {
                    "type": "number",
                    "maximum": 10000,
                    "minimum": 0,
                    "example": 8
                },
                "latitude": {
                    "type": "number",
                    "maximum": 80,
                    "minimum": -80,
                    "example": 52.52
                },
                "longitude": {
                    "type": "number",
                    "maximum": 180,
                    "minimum": -180,
                    "example": 13.405
                },
                "playerId": {
                    "type": "string",
                    "maxLength": 32,
                    "minLength": 32,
                    "example": "8899aabbccddeeff0011223344556677"
                },
                "recordedAt": {
                    "type": "string",
                    "example": "2026-11-08T12:04:58Z"
                }
            }
        },
        "controller.JokerResponse": {
            "type": "object",
            "required": [
                "available",
                "kind"
            ],
            "properties": {
                "available": {
                    "description": "True while the game runs and the team has not used it yet.",
                    "type": "boolean",
                    "example": true
                },
                "kind": {
                    "type": "string",
                    "enum": [
                        "showRunners"
                    ],
                    "example": "showRunners"
                },
                "positions": {
                    "description": "What the joker showed (showRunners: each runner's position at usedAt), once used.",
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/controller.JokerPositionResponse"
                    }
                },
                "usedAt": {
                    "description": "Set once the team used it.",
                    "type": "string",
                    "example": "2026-11-08T12:07:00Z"
