  "info": {
    "contact": {},
    "description": "API generated from Go handler annotations and response structs.",
    "title": "Catch me! API",
    "version": "0.1.0"
  },
  "paths": {
    "/api/games": {
      "post": {
        "consumes": [
          "application/json"
        ],
        "operationId": "createGame",
        "parameters": [
          {
            "description": "Both coordinates required; cellSizeMeters is 100-5000 in steps of 100, omitted/null defaults to 2000; no date-line crossings",
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/CreateGameRequest"
            }
          }
        ],
        "produces": [
          "application/json"
        ],
        "responses": {
          "201": {
            "description": "Game saved, with one join code per team",
            "schema": {
              "$ref": "#/definitions/CreateGameResponse"
            }
          },
          "400": {
            "description": "Invalid JSON, coordinates, or cell size",
            "schema": {
              "$ref": "#/definitions/ApiError"
            }
          },
          "403": {
            "description": "Browser origin is not allowed",
            "schema": {
              "$ref": "#/definitions/ApiError"
            }
          },
          "405": {
            "description": "Method not allowed",
            "schema": {
              "$ref": "#/definitions/ApiError"
            }
          },
          "413": {
            "description": "Request body exceeds 1024 bytes",
            "schema": {
              "$ref": "#/definitions/ApiError"
            }
          },
          "500": {
            "description": "Could not save game",
            "schema": {
              "$ref": "#/definitions/ApiError"
            }
          }
        },
        "summary": "Create a 6 by 6 playground with adjustable cell size (default 2000 meters)"
      }
    },
    "/api/games/{sessionId}": {
      "get": {
        "operationId": "getGame",
        "parameters": [
          {
            "description": "32 lowercase hexadecimal characters",
            "in": "path",
            "name": "sessionId",
            "required": true,
            "type": "string"
          }
        ],
        "produces": [
          "application/json"
        ],
        "responses": {
          "200": {
            "description": "Saved game",
            "schema": {
              "$ref": "#/definitions/GameResponse"
            }
          },
          "400": {
            "description": "Invalid session ID",
            "schema": {
              "$ref": "#/definitions/ApiError"
            }
          },
          "403": {
            "description": "Browser origin is not allowed",
            "schema": {
              "$ref": "#/definitions/ApiError"
            }
          },
          "404": {
            "description": "Game not found",
            "schema": {
              "$ref": "#/definitions/ApiError"
            }
          },
          "405": {
            "description": "Method not allowed",
            "schema": {
              "$ref": "#/definitions/ApiError"
            }
          },
          "500": {
            "description": "Could not load game",
            "schema": {
              "$ref": "#/definitions/ApiError"
            }
          }
        },
        "summary": "Load a saved game playground"
      }
    },
    "/api/me": {
      "delete": {
        "operationId": "leaveGame",
        "produces": [
          "application/json"
        ],
        "responses": {
          "204": {
            "description": "Left the game; the token is no longer valid"
          },
          "401": {
            "description": "Missing or unknown player token",
            "schema": {
              "$ref": "#/definitions/ApiError"
            }
          },
          "403": {
            "description": "Browser origin is not allowed",
            "schema": {
              "$ref": "#/definitions/ApiError"
            }
          },
          "405": {
            "description": "Method not allowed",
            "schema": {
              "$ref": "#/definitions/ApiError"
            }
          },
          "409": {
            "description": "Game has already started",
            "schema": {
              "$ref": "#/definitions/ApiError"
            }
          },
          "500": {
            "description": "Could not update game",
            "schema": {
              "$ref": "#/definitions/ApiError"
            }
          }
        },
        "security": [
          {
            "PlayerToken": []
          }
        ],
        "summary": "Leave the game before it starts"
      }
    },
    "/api/me/game": {
      "get": {
        "operationId": "getGameState",
        "produces": [
          "application/json"
        ],
        "responses": {
          "200": {
            "description": "Current game state",
            "schema": {
              "$ref": "#/definitions/GameStateResponse"
            }
          },
          "401": {
            "description": "Missing or unknown player token",
            "schema": {
              "$ref": "#/definitions/ApiError"
            }
          },
          "403": {
            "description": "Browser origin is not allowed",
            "schema": {
              "$ref": "#/definitions/ApiError"
            }
          },
          "405": {
            "description": "Method not allowed",
            "schema": {
              "$ref": "#/definitions/ApiError"
            }
          },
          "500": {
            "description": "Could not load game",
            "schema": {
              "$ref": "#/definitions/ApiError"
            }
          }
        },
        "security": [
          {
            "PlayerToken": []
          }
        ],
        "summary": "Get the game state for the authenticated player"
      }
    },
    "/api/me/position": {
      "put": {
        "consumes": [
          "application/json"
        ],
        "operationId": "updatePosition",
        "parameters": [
          {
            "description": "Current coordinates and accuracy radius; the server records its own time",
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/UpdatePositionRequest"
            }
          }
        ],
        "produces": [
          "application/json"
        ],
        "responses": {
          "200": {
            "description": "Updated game state",
            "schema": {
              "$ref": "#/definitions/GameStateResponse"
            }
          },
          "400": {
            "description": "Invalid JSON, coordinates, or accuracy",
            "schema": {
              "$ref": "#/definitions/ApiError"
            }
          },
          "401": {
            "description": "Missing or unknown player token",
            "schema": {
              "$ref": "#/definitions/ApiError"
            }
          },
          "403": {
            "description": "Browser origin is not allowed",
            "schema": {
              "$ref": "#/definitions/ApiError"
            }
          },
          "405": {
            "description": "Method not allowed",
            "schema": {
              "$ref": "#/definitions/ApiError"
            }
          },
          "413": {
            "description": "Request body exceeds 1024 bytes",
            "schema": {
              "$ref": "#/definitions/ApiError"
            }
          },
          "500": {
            "description": "Could not update game",
            "schema": {
              "$ref": "#/definitions/ApiError"
            }
          }
        },
        "security": [
          {
            "PlayerToken": []
          }
        ],
        "summary": "Report the authenticated player's current position"
      }
    },
    "/api/me/ready": {
      "put": {
        "consumes": [
          "application/json"
        ],
        "operationId": "setReady",
        "parameters": [
          {
            "description": "Ready state; the game starts 10 seconds after all players are ready and both teams have players",
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/SetReadyRequest"
            }
          }
        ],
        "produces": [
          "application/json"
        ],
        "responses": {
          "200": {
            "description": "Updated game state",
            "schema": {
              "$ref": "#/definitions/GameStateResponse"
            }
          },
          "400": {
            "description": "Invalid JSON or missing ready value",
            "schema": {
              "$ref": "#/definitions/ApiError"
            }
          },
          "401": {
            "description": "Missing or unknown player token",
            "schema": {
              "$ref": "#/definitions/ApiError"
            }
          },
          "403": {
            "description": "Browser origin is not allowed",
            "schema": {
              "$ref": "#/definitions/ApiError"
            }
          },
          "405": {
            "description": "Method not allowed",
            "schema": {
              "$ref": "#/definitions/ApiError"
            }
          },
          "409": {
            "description": "Game has already started, or the runner is not in their start cell",
            "schema": {
              "$ref": "#/definitions/ApiError"
            }
          },
          "413": {
            "description": "Request body exceeds 1024 bytes",
            "schema": {
              "$ref": "#/definitions/ApiError"
            }
          },
          "500": {
            "description": "Could not update game",
            "schema": {
              "$ref": "#/definitions/ApiError"
            }
          }
        },
        "security": [
          {
            "PlayerToken": []
          }
        ],
        "summary": "Set the authenticated player's ready state"
      }
    },
    "/api/me/route": {
      "post": {
        "operationId": "regenerateRoute",
        "produces": [
          "application/json"
        ],
        "responses": {
          "200": {
            "description": "Updated game state with the new route",
            "schema": {
              "$ref": "#/definitions/GameStateResponse"
            }
          },
          "401": {
            "description": "Missing or unknown player token",
            "schema": {
              "$ref": "#/definitions/ApiError"
            }
          },
          "403": {
            "description": "Browser origin is not allowed",
            "schema": {
              "$ref": "#/definitions/ApiError"
            }
          },
          "405": {
            "description": "Method not allowed",
            "schema": {
              "$ref": "#/definitions/ApiError"
            }
          },
          "409": {
            "description": "Not a runner, ready, no changes left, or game started",
            "schema": {
              "$ref": "#/definitions/ApiError"
            }
          },
          "500": {
            "description": "Could not update game",
            "schema": {
              "$ref": "#/definitions/ApiError"
            }
          }
        },
        "security": [
          {
            "PlayerToken": []
          }
        ],
        "summary": "Regenerate the authenticated runner's route"
      }
    },
    "/api/players": {
      "post": {
        "consumes": [
          "application/json"
        ],
        "operationId": "joinGame",
        "parameters": [
          {
            "description": "Join code (case-insensitive) and display name (1-20 characters, unique per game)",
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/JoinGameRequest"
            }
          }
        ],
        "produces": [
          "application/json"
        ],
        "responses": {
          "201": {
            "description": "Joined; keep the player token secret",
            "schema": {
              "$ref": "#/definitions/JoinGameResponse"
            }
          },
          "400": {
            "description": "Invalid JSON, join code, or name",
            "schema": {
              "$ref": "#/definitions/ApiError"
            }
          },
          "403": {
            "description": "Browser origin is not allowed",
            "schema": {
              "$ref": "#/definitions/ApiError"
            }
          },
          "404": {
            "description": "No game with this join code",
            "schema": {
              "$ref": "#/definitions/ApiError"
            }
          },
          "405": {
            "description": "Method not allowed",
            "schema": {
              "$ref": "#/definitions/ApiError"
            }
          },
          "409": {
            "description": "Game started, full, or name taken",
            "schema": {
              "$ref": "#/definitions/ApiError"
            }
          },
          "413": {
            "description": "Request body exceeds 1024 bytes",
            "schema": {
              "$ref": "#/definitions/ApiError"
            }
          },
          "500": {
            "description": "Could not join game",
            "schema": {
              "$ref": "#/definitions/ApiError"
            }
          }
        },
        "summary": "Join a game with a team join code"
      }
    },
    "/health": {
      "get": {
        "operationId": "getHealth",
        "produces": [
          "application/json"
        ],
        "responses": {
          "200": {
            "description": "Backend is running",
            "schema": {
              "$ref": "#/definitions/HealthResponse"
            }
          },
          "403": {
            "description": "Browser origin is not allowed",
            "schema": {
              "$ref": "#/definitions/ApiError"
            }
          }
        },
        "summary": "Check backend health"
      }
    }
  },
  "securityDefinitions": {
    "PlayerToken": {
      "description": "\"Bearer \" followed by the playerToken returned when joining a game.",
      "in": "header",
      "name": "Authorization",
      "type": "apiKey"
    }
