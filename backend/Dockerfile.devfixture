FROM golang:1.26-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/devfixture/*.go ./cmd/devfixture/
COPY game/*.go ./game/
COPY geo/*.go ./geo/
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/devfixture ./cmd/devfixture

FROM registry.opencode.de/oci-community/images/zendis/static:1.0.0-minimal@sha256:b9d32313fd20a8f6aa9811e087ef033cf6d36fd3f5f3c390d135ecee39936cf5
WORKDIR /app
COPY --from=build /out/devfixture ./devfixture
# Match the backend's user so SQLite journal files have compatible ownership.
USER 53111:53111
ENTRYPOINT ["/app/devfixture"]
