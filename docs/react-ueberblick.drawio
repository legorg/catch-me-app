  <diagram id="datenfluss" name="2 - React-Datenfluss">
    <mxGraphModel dx="1100" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="p2-0" />
        <mxCell id="p2-1" parent="p2-0" />
        <mxCell id="p2-title" value="Wie React reagiert: Ereignis → State → Oberfläche" style="text;html=0;align=center;fontSize=24;fontStyle=1;" parent="p2-1" vertex="1">
          <mxGeometry x="40" y="20" width="1080" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p2-input" value="1. Ereignis&#xa;Spieler tippt einen Namen&#xa;TextInput meldet onChangeText" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;" parent="p2-1" vertex="1">
          <mxGeometry x="60" y="130" width="290" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p2-state" value="2. State-Update anfordern&#xa;setName(&#39;Anna&#39;)&#xa;React merkt den neuen Wert vor" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;" parent="p2-1" vertex="1">
          <mxGeometry x="430" y="130" width="290" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p2-render" value="3. Rendern&#xa;HomeScreen wird erneut ausgeführt&#xa;name = &#39;Anna&#39;; canJoin neu berechnen&#xa;JSX beschreibt die gewünschte UI" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;" parent="p2-1" vertex="1">
          <mxGeometry x="800" y="130" width="300" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p2-commit" value="4. Abgleichen und übernehmen&#xa;React vergleicht Elementbäume&#xa;Renderer aktualisiert nötige UI-Teile&#xa;Nicht den ganzen Screen neu aufbauen" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;" parent="p2-1" vertex="1">
          <mxGeometry x="800" y="310" width="300" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p2-ui" value="5. Aktualisierte Oberfläche&#xa;TextInput value={name}&#xa;Button disabled={busy || !canJoin}&#xa;Bereit für das nächste Ereignis" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;" parent="p2-1" vertex="1">
          <mxGeometry x="60" y="310" width="290" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p2-a" style="edgeStyle=orthogonalEdgeStyle;html=0;endArrow=block;" parent="p2-1" source="p2-input" target="p2-state" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-b" style="edgeStyle=orthogonalEdgeStyle;html=0;endArrow=block;" parent="p2-1" source="p2-state" target="p2-render" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-c" style="edgeStyle=orthogonalEdgeStyle;html=0;endArrow=block;" parent="p2-1" source="p2-render" target="p2-commit" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-d" value="UI-Änderungen" style="edgeStyle=orthogonalEdgeStyle;html=0;endArrow=block;" parent="p2-1" source="p2-commit" target="p2-ui" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-e" value="nächste Eingabe" style="edgeStyle=orthogonalEdgeStyle;html=0;endArrow=block;dashed=1;" parent="p2-1" source="p2-ui" target="p2-input" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-note" value="State ist der Wert des jeweiligen Renderdurchlaufs. Setter sind keine sofortigen lokalen Zuweisungen.&#xa;React kann mehrere Updates zusammenfassen. Props kommen vom Elternbaustein; Callbacks melden Ereignisse zurück." style="text;html=0;align=center;whiteSpace=wrap;fontSize=14;" parent="p2-1" vertex="1">
          <mxGeometry x="60" y="455" width="1040" height="55" as="geometry" />
        </mxCell>
        <mxCell id="p2-lobbytitle" value="Dasselbe Prinzip mit Backend-Daten: Lobby / Ready" style="text;html=0;align=left;fontSize=20;fontStyle=1;" parent="p2-1" vertex="1">
          <mxGeometry x="60" y="555" width="1040" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p2-trigger" value="Auslöser&#xa;Ready-Button: setReady(...)&#xa;oder Polling: getGameState(...)&#xa;oder Position: updatePosition(...)" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" parent="p2-1" vertex="1">
          <mxGeometry x="60" y="640" width="290" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p2-server" value="API-Client → HTTP → Go-Backend&#xa;Backend verarbeitet die Anfrage&#xa;und liefert erlaubten Spielzustand&#xa;Fehler werden separat angezeigt" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;" parent="p2-1" vertex="1">
          <mxGeometry x="430" y="640" width="290" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p2-snapshot" value="show(state) → setSnapshot(...)&#xa;Neuer lokaler React-State&#xa;LobbyScreen rendert erneut&#xa;Karte, Spieler und Status aktualisieren" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" parent="p2-1" vertex="1">
          <mxGeometry x="800" y="640" width="300" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p2-f" value="Anfrage" style="edgeStyle=orthogonalEdgeStyle;html=0;endArrow=block;" parent="p2-1" source="p2-trigger" target="p2-server" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-g" value="geprüfte Antwort" style="edgeStyle=orthogonalEdgeStyle;html=0;endArrow=block;" parent="p2-1" source="p2-server" target="p2-snapshot" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-effects" value="Effekte verbinden mit der Außenwelt&#xa;useFocusEffect: beim Fokus Polling starten, beim Verlassen Timer stoppen.&#xa;useEffect: Standortbeobachtung einrichten / aufräumen oder den Kartenausschnitt anpassen.&#xa;useRef: Referenz aufbewahren, ohne selbst einen Render auszulösen.&#xa;Abgeleitete Werte wie canJoin werden direkt berechnet, nicht über einen Effekt synchronisiert." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;align=left;spacing=16;" parent="p2-1" vertex="1">
          <mxGeometry x="60" y="805" width="1040" height="130" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
