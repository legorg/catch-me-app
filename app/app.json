{
  "expo": {
    "name": "Catch me!",
    "slug": "catch-me",
    "scheme": "catch-me",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "de.loewenburg.catchme",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "de.loewenburg.catchme",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-localization",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Catch me! shares your position with your teammates during a game and checks that runners start in their start cell.",
          "locationAlwaysAndWhenInUsePermission": "Catch me! keeps sharing your position with your team while a game runs, even when the screen is off. Sharing stops when you leave the game.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true
        }
      ]
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "da52a931-69e4-42c0-9c84-126a1451c3c0"
      }
    }
  }
}
